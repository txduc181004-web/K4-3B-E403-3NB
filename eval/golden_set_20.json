      "challenge_class": "1_source_truth",
      "input_grid_cell": "ambiguous|learning|generic|missing",
      "source": "chatlog: T13483",
      "question": "(Đang học phần day01-slide-v2-blue của buổi này) này nghĩa là sao?? Tóm tắt lại điểm hạn chế của RNN là gì",
      "expected_topic": "RNN limitation",
      "expected_behavior": "identify and explain limitation"
    },
    {
      "id": "G02",
      "challenge_class": "1_source_truth",
      "input_grid_cell": "clear|learning|specific|present",
