{
  "dataset_name": "topic_gap_triage_golden_set_v1",
  "description": "Golden set cho prototype detect topic gaps trong chatlog học tập. Có 20 case, bao phủ 4 lớp chỗ khó và tối thiểu 10 case từ dữ liệu chatlog thật hoặc biến thể gần gũi.",
  "user_input_grid": {
    "dimensions": [
      {
        "name": "clarity",
        "description": "Mức rõ ràng của câu hỏi",
        "values": ["clear", "ambiguous"]
      },
      {
        "name": "scope",
        "description": "Câu hỏi có nằm trong phạm vi triage học tập không",
        "values": ["learning", "logistics", "out_of_scope"]
      },
      {
        "name": "technical_specificity",
        "description": "Mức cụ thể của chủ đề kỹ thuật",
        "values": ["specific", "generic"]
      },
      {
        "name": "evidence_context",
        "description": "Mức căn cứ/ngữ cảnh có trong câu hỏi",
        "values": ["present", "missing"]
      }
    ],
    "coverage_cells": {
      "clear|learning|specific|present": ["G02", "G03", "G04", "G13", "G14", "G15", "G16", "G20"],
      "ambiguous|learning|generic|missing": ["G01", "G05", "G17"],
      "ambiguous|learning|specific|present": ["G06", "G07", "G08", "G18"],
      "clear|out_of_scope|generic|present": ["G09", "G10", "G19"],
      "clear|logistics|generic|missing": ["G11", "G12"]
    },
    "uncovered_cells": [
      "ambiguous|logistics|generic|missing",
      "ambiguous|out_of_scope|generic|missing",
      "clear|learning|generic|missing"
    ]
  },
  "cases": [
    {
